env HOME=$WORK
env XDG_CONFIG_HOME=$WORK/.config
env XDG_DATA_HOME=$WORK/.local/share
env XDG_STATE_HOME=$WORK/.local/state

exec mw init
stdout 'Initialized'

# Verify files were created
exists $WORK/.config/makework/config.toml
exists $WORK/.config/makework/catalog.toml

# Second init should be idempotent (no error)
exec mw init
